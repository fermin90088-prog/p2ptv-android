<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#38FBBF24" />
            <stroke android:width="2dp" android:color="#FBBF24" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FBBF24" />
            <stroke android:width="1dp" android:color="#66FBBF24" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
